---
// Bookmarks component.
//
// The markup below renders during the static build. The dynamic behavior —
// adding a bookmark, generating a short slug, and persisting to the browser —
// runs ONLY in the client-side <script> boundary at the bottom of this
// file. Astro runs that script in the browser, never during the build, so
// browser-only APIs are safe there. The storage/formatting/slug logic itself
// lives in ../lib/bookmarks.ts as plain, unit-testable functions.
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL (with or without <code>https://</code>) and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<style>
  #add-bookmark {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem;
  }

  #bookmark-list {
    margin-top: 0.5rem;
  }

  li.bookmark {
    background: color-mix(in srgb, canvas 96%, var(--accent) 4%);
    transition: border-color 0.15s ease;
  }
  li.bookmark:hover {
    border-color: color-mix(in srgb, var(--accent) 50%, var(--border));
  }

  .bookmark .entry {
    flex: 1 1 14rem;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem;
    overflow-wrap: anywhere;
    font-family: var(--font-body);
  }
  .bookmark .url {
    font-family: var(--font-head);
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
  .bookmark .url:hover,
  .bookmark .url:focus-visible {
    text-decoration: underline;
  }
  .bookmark .sep {
    color: var(--muted);
  }
  .bookmark .slug {
    font-family: var(--font-body);
  }
</style>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  //
  // Because this code lives in a client <script>, browser storage APIs are
  // safe to use here without breaking the static build. All the pure logic
  // (URL normalization, slug generation, storage validation, formatting)
  // lives in ../lib/bookmarks.ts and is covered by unit tests there.
  import {
    formatBookmark,
    generateUniqueSlug,
    loadBookmarks,
    normalizeUrl,
    saveBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const urlInput = document.getElementById('url') as HTMLInputElement | null;
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAllButton = document.getElementById('clear-all');

  function render(bookmarks: Bookmark[]) {
    if (!list || !emptyState || !listHeader) return;

    list.innerHTML = '';

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const entry = document.createElement('span');
      entry.className = 'entry';
      entry.title = formatBookmark(bookmark);

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'sep';
      separator.textContent = ' :: ';

      const slugBadge = document.createElement('span');
      slugBadge.className = 'slug';
      slugBadge.textContent = bookmark.slug;

      entry.append(link, separator, slugBadge);

      const copyButton = document.createElement('button');
      copyButton.type = 'button';
      copyButton.className = 'copy';
      copyButton.textContent = 'Copy';
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          const original = copyButton.textContent;
          copyButton.textContent = 'Copied!';
          setTimeout(() => {
            copyButton.textContent = original ?? 'Copy';
          }, 1500);
        } catch {
          // Clipboard API may be unavailable; fail silently.
        }
      });

      item.append(entry, copyButton);
      list.append(item);
    }
  }

  function addBookmark(url: string) {
    const bookmarks = loadBookmarks();
    const slug = generateUniqueSlug(bookmarks);
    bookmarks.push({ url, slug });
    saveBookmarks(bookmarks);
    render(bookmarks);
  }

  form?.addEventListener('submit', (event) => {
    // Keep this call FIRST, unconditionally: even if something later in this
    // handler throws, the form must never fall back to a native submit that
    // reloads the page and loses the URL the user typed.
    event.preventDefault();

    try {
      if (!urlInput) return;

      const normalized = normalizeUrl(urlInput.value);
      if (!normalized) {
        urlInput.setCustomValidity('Please enter a valid URL.');
        urlInput.reportValidity();
        return;
      }
      urlInput.setCustomValidity('');

      addBookmark(normalized);
      form.reset();
      urlInput.focus();
    } catch (error) {
      console.error('Failed to add bookmark:', error);
    }
  });

  clearAllButton?.addEventListener('click', () => {
    if (!confirm('Remove all saved bookmarks?')) return;
    saveBookmarks([]);
    render([]);
  });

  // On page load, read the saved bookmarks from storage and render them so
  // the list persists across reloads.
  render(loadBookmarks());
</script>
